@baseUrl = http://localhost:3001
@contentType = application/json
@csrfToken = dev-csrf-token

# Data seed: student@akara.sch.id / Password123!
# Token ini berasal dari prisma/seed.sql agar endpoint protected bisa dites langsung.
@sessionToken = token-student-active
@email = student@akara.sch.id
@password = Password123!

# ID seed yang aman untuk user student@akara.sch.id.
@moduleId = 1
@lessonId = 1
@quizId = 1
@taskId = 3

# Catatan pemakaian:
# 1. Jalankan server dengan `npm run dev` sebelum menjalankan request.
# 2. Untuk request protected, seed database harus sudah dimuat.
# 3. Jika session seed sudah invalid karena logout, jalankan request Login lalu gunakan cookie dari REST Client cookie jar.
# 4. Jika CSRF aktif, header X-CSRF-TOKEN harus sama dengan cookie XSRF-TOKEN.

### Health check
# @name health
GET {{baseUrl}}/health

> {%
client.test("Health returns 200", function () {
  client.assert(response.status === 200, "Expected status 200");
});
%}

### Issue CSRF cookie
# @name csrfCookie
GET {{baseUrl}}/api/csrf-cookie

> {%
client.test("CSRF cookie returns 204", function () {
  client.assert(response.status === 204, "Expected status 204");
});
%}

### Login
# @name login
POST {{baseUrl}}/login
Content-Type: {{contentType}}
Cookie: XSRF-TOKEN={{csrfToken}}
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
client.test("Login returns 200", function () {
  client.assert(response.status === 200, "Expected status 200");
});
%}

